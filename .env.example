# ============================================================
# dy-pipeline-skill 环境配置模板
# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会泄露）
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================================

# ---- LLM（必填，OpenAI 兼容接口）----
# 文本模型（分析/生成/评审）。默认智谱免费档：
LLM_API_KEY=你的key
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# 视觉模型（看懂画面，需求卡 视觉设置.模型 可单独覆盖）
# 默认走 LLM_API_BASE 的同款 key；免费档 glm-4v-flash
# VISION_MODEL=glm-4v-flash

# ---- 豆包 ASR（可选，转写提速几十倍；不配则用本地 faster-whisper）----
# VOLC_ASR_APPID=...
# VOLC_ASR_ACCESS_TOKEN=...
